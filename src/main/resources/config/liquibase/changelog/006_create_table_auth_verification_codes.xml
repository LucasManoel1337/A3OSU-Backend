<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="041120261900" author="lucasmp">
        <createTable tableName="tb_auth_verification_codes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_auth_code_user" references="tb_users(id)"/>
            </column>
            <column name="purpose" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="code_hash" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="tb_auth_verification_codes"
                             columnNames="user_id,purpose"
                             constraintName="uk_auth_code_user_purpose"/>
    </changeSet>
</databaseChangeLog>
