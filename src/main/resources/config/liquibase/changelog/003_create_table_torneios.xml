<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="110620262145" author="lucasmp">
        <createTable tableName="tb_torneios">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="nome" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>

            <column name="tipo" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="modo" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="vagas" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="descricao" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>

            <column name="is_privado" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="senha" type="VARCHAR(255)">
            </column>

            <!-- Mudança AQUI: LONGBLOB para salvar imagens direto no banco -->
            <column name="banner" type="LONGBLOB">
            </column>

            <column name="logo" type="LONGBLOB">
            </column>

            <column name="criado_em" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="atualizado_em" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="criador_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="tb_torneios"/>
        </rollback>
    </changeSet>

    <changeSet id="140620261905" author="lucasmp">
        <addColumn tableName="tb_torneios">
            <column name="vagas_restantes" type="INT">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="tb_torneios" columnName="vagas_restantes"/>
        </rollback>
    </changeSet>

    <changeSet id="170620260452" author="lucasmp">
        <addColumn tableName="tb_torneios">
            <column name="data_inicio" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="hora_inicio" type="TIME">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>